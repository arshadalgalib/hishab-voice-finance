# Normalise line endings to LF in the repository, regardless of the
# contributor's OS. Windows checkouts still get CRLF for text files via
# `text=auto`, which keeps Git happy and diffs clean.
* text=auto eol=lf

# Explicitly binary — never diff or normalise these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.otf  binary
*.ttf  binary
*.ttc  binary
*.so   binary
*.jar  binary
*.apk  binary
*.aab  binary
*.keystore binary
*.jks  binary

# Keep generated Drift code out of GitHub's language statistics.
lib/**/*.g.dart linguist-generated=true
